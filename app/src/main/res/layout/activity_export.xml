<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnCloseExport"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_24"
            app:tint="@color/textColor" />

        <TextView
            android:id="@+id/tvExportHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/export"
            android:textColor="@color/textColor"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Main Content Container (Centered ScrollView) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopBar"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 1. EXPORT IN PROGRESS STATE -->
            <LinearLayout
                android:id="@+id/layoutExporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Video Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surfaceContainerHigh"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/ivExportThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#20222E"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_banner_foreground" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvExportProjectName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:text="@string/app_name"
                                android:textColor="@color/textColor"
                                android:textSize="16sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvBadgeResolution"
                                    android:layout_width="wrap_content"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_pill_dark"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:text="1080p"
                                    android:textColor="#C5C7D3"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvBadgeFps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_pill_dark"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:text="30 FPS"
                                    android:textColor="#C5C7D3"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvBadgeFormat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_pill_dark"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:text="MP4"
                                    android:textColor="#C5C7D3"
                                    android:textSize="11sp" />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Center Circular Progress Indicator -->
                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="40dp">

                    <ProgressBar
                        android:id="@+id/exportProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/circular_progress_bar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="0%"
                            android:textColor="@color/colorPrimary"
                            android:textSize="32sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="EXPORTING"
                            android:textColor="@color/toolTextInactive"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Status Texts -->
                <TextView
                    android:id="@+id/tvExportStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_saving_video"
                    android:textColor="@color/textColor"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/tvExportStatusMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/str_please_don_t_close_the_app"
                    android:textAlignment="center"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="14sp" />

                <!-- Cancel Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelExport"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="36dp"
                    android:backgroundTint="@color/surfaceContainerHigh"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="28dp"
                    android:text="@string/cancel"
                    android:textColor="#FF4D6D"
                    android:textSize="14sp"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/outlineVariant"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- 2. EXPORT SUCCESS COMPLETION STATE -->
            <LinearLayout
                android:id="@+id/layoutExportSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <!-- Glowing Success Checkmark -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/circle_primary_container">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_24"
                        app:tint="@color/onPrimaryContainer" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Export Complete!"
                    android:textColor="@color/textColor"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Your video has been saved to Gallery"
                    android:textAlignment="center"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="14sp" />

                <!-- Destination Folder Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surfaceContainerHigh"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_folder_24"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tvSavedFilePath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:fontFamily="sans-serif"
                            android:singleLine="true"
                            android:text="Saved to Gallery (Movies/Eclip)"
                            android:textColor="@color/textColor"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Actions -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayVideo"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Play Video"
                    android:textColor="@color/onPrimaryContainer"
                    android:textSize="15sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_play_24"
                    app:iconGravity="textStart"
                    app:iconTint="@color/onPrimaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareVideo"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/surfaceContainerHigh"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Share Video"
                    android:textColor="@color/textColor"
                    android:textSize="15sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_share_24"
                    app:iconGravity="textStart"
                    app:iconTint="@color/textColor"
                    app:strokeColor="@color/outlineVariant"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDoneExporting"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/surfaceVariant"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Back to Editor"
                    android:textColor="@color/textColor"
                    android:textSize="15sp"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

            <!-- 3. EXPORT FAILURE STATE -->
            <LinearLayout
                android:id="@+id/layoutExportFailure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/circle_primary_container">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_warning_24"
                        app:tint="#FF4D6D" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Export Failed"
                    android:textColor="@color/textColor"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="An error occurred while exporting the video."
                    android:textAlignment="center"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToEditorError"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="@color/surfaceVariant"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Back to Editor"
                    android:textColor="@color/textColor"
                    android:textSize="15sp"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
