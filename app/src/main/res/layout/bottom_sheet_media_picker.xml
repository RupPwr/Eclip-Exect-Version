<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Unified Top Bar: Close 'X' button aligned directly with TabLayout -->
    <RelativeLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Close 'X' Button on the left -->
        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close_24"
            app:tint="#FFFFFF" />

        <!-- TabLayout for Smooth Tab Switching & Indicator Animations -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutGallery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/btnCloseSheet"
            android:layout_marginEnd="40dp"
            android:background="@android:color/transparent"
            app:tabBackground="@android:color/transparent"
            app:tabGravity="center"
            app:tabMode="fixed"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="#FF2A6D"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorGravity="bottom"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextColor="#8E8E93"
            app:tabTextAppearance="@style/GalleryTabTextAppearance"
            app:tabRippleColor="@android:color/transparent" />

    </RelativeLayout>

    <!-- ViewPager2 for Smooth Swipe Navigation between tabs -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerGallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <!-- Bottom Selected Media Tray (CapCut Style) -->
    <LinearLayout
        android:id="@+id/layoutSelectedTray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#121215"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="14dp"
        android:visibility="gone">

        <!-- Top row of tray: Trash icon + Count text + Pink Next FAB -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnDeleteSelected"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_delete_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvSelectedSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Selected 0 Video(s)/0 Photo(s)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Floating circular pink action button (Next / Confirm) -->
            <FrameLayout
                android:id="@+id/btnConfirmSelection"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_gallery_fab_next"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_forward_24"
                    app:tint="#FFFFFF" />
            </FrameLayout>

        </RelativeLayout>

        <!-- Horizontal list of selected thumbnail previews -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectedItems"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle hint: Long press and drag to swap order -->
        <TextView
            android:id="@+id/tvSwapHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long press and drag to swap order"
            android:textColor="#666666"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
