<?xml version="1.0" encoding="utf-8"?>
<com.eclip.rup.leb.customviews.SquareFrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGridContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#1E1E24" />

    <!-- Gradient overlay at bottom for duration readability -->
    <View
        android:id="@+id/vGradient"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_media_gradient" />

    <!-- Selected Tint Overlay (Darkens thumbnail when selected) -->
    <View
        android:id="@+id/vSelectedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#60000000"
        android:visibility="gone" />

    <!-- Selection Badge at Top-Right -->
    <FrameLayout
        android:id="@+id/layoutSelectionBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_gallery_unselected_badge">

        <TextView
            android:id="@+id/tvSelectionNumber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Video Duration Badge at Bottom-Left -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="4dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</com.eclip.rup.leb.customviews.SquareFrameLayout>
