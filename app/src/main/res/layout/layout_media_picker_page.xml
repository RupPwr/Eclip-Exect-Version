<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPageMediaGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@drawable/bg_duration_badge" />

    <ProgressBar
        android:id="@+id/pbPageLoading"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FF2A6D"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/layoutPageEmptyContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivPageEmptyIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_image_24"
            app:tint="#555555"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvPageEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No media found on device."
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPageGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Allow Access"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF2A6D"
            app:cornerRadius="20dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPageSystemPickerFallback"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Browse System Folders"
            android:textColor="#FF2A6D" />
    </LinearLayout>

</FrameLayout>
