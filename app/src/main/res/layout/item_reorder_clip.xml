<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_track_selected"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/tvClipIndex"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:background="@drawable/circle_primary_container"
        android:text="1"
        android:textColor="@color/textColor"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold" />

    <TextView
        android:id="@+id/tvClipName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Clip 1 (00:05.0)"
        android:textColor="@color/textColor"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:fontFamily="sans-serif-medium" />

    <!-- Move Up Button -->
    <ImageButton
        android:id="@+id/btnMoveUp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_up_24"
        android:scaleType="centerInside"
        app:tint="@color/textColor" />

    <!-- Move Down Button -->
    <ImageButton
        android:id="@+id/btnMoveDown"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_down_24"
        android:scaleType="centerInside"
        app:tint="@color/textColor" />
</LinearLayout>
