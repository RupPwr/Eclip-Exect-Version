<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Text Style Formatting (Bold | Italic | Underline | AA) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Style"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Bold Button -->
            <TextView
                android:id="@+id/btnFormatBold"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#8A8A93"
                android:background="@drawable/tool_button_inactive"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <!-- Italic Button -->
            <TextView
                android:id="@+id/btnFormatItalic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="I"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="#8A8A93"
                android:background="@drawable/tool_button_inactive"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <!-- Underline Button -->
            <TextView
                android:id="@+id/btnFormatUnderline"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="U"
                android:textSize="16sp"
                android:textColor="#8A8A93"
                android:background="@drawable/tool_button_inactive"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <!-- AA (Case) Button -->
            <TextView
                android:id="@+id/btnFormatCase"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Aa"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#8A8A93"
                android:background="@drawable/tool_button_inactive"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fonts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Font"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <LinearLayout
            android:id="@+id/btnSelectFont"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/tool_button_inactive"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSelectedFontName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Roboto Regular"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_drop_down_24"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Opacity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Opacity"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <com.google.android.material.slider.Slider
            android:id="@+id/seekOpacity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            android:value="100" />
    </LinearLayout>

    <!-- Border Thickness -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Shadow"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <com.google.android.material.slider.Slider
            android:id="@+id/seekBorderWidth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            android:value="15" />
    </LinearLayout>

    <!-- Letter Spacing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Letter Spacing"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <com.google.android.material.slider.Slider
            android:id="@+id/seekLetterSpacing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            android:value="50" />
    </LinearLayout>

    <!-- Line Spacing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Line Spacing"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <com.google.android.material.slider.Slider
            android:id="@+id/seekLineSpacing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            android:value="50" />
    </LinearLayout>

    <!-- Alignment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Alignment"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignLeft"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_align_left_24"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            android:backgroundTint="@color/inactiveToolBackground" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignCenter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_align_center_24"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            android:backgroundTint="@color/colorPrimary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignRight"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_align_right_24"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            android:backgroundTint="@color/inactiveToolBackground" />
    </LinearLayout>

</LinearLayout>
