<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/presetContainer"
    android:layout_width="72dp"
    android:layout_height="80dp"
    android:layout_marginEnd="10dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/tool_button_inactive"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ivPresetIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_tool_animation"
        app:tint="@color/toolTextInactive" />

    <TextView
        android:id="@+id/tvPresetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Fade In"
        android:textColor="@color/toolTextInactive"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
