<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDraftRoot"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_draft_card"
    android:clickable="true"
    android:focusable="true">

    <!-- Thumbnail Image -->
    <ImageView
        android:id="@+id/ivDraftThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Fallback Placeholder when thumbnail is unavailable -->
    <ImageView
        android:id="@+id/ivDraftPlaceholder"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_clips_24"
        app:tint="@color/iconSecondary"
        android:alpha="0.4"
        android:visibility="visible" />

    <!-- Selected Tint Overlay -->
    <View
        android:id="@+id/vDraftSelectedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#60000000"
        android:visibility="gone" />

    <!-- Bottom Meta Overlay Scrim -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_media_gradient"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/layoutDraftActionContainer"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDraftTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Draft Project"
                android:textColor="@color/textColor"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvDraftDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/iconSecondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Container for Three-Line Icon OR Selection Circle -->
        <FrameLayout
            android:id="@+id/layoutDraftActionContainer"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Normal state: Three-line / options icon -->
            <ImageView
                android:id="@+id/btnDraftOptions"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/ic_list_view_24"
                app:tint="@color/textColor"
                android:visibility="visible" />

            <!-- Selection mode: Selection Circle Checkbox -->
            <ImageView
                android:id="@+id/ivDraftCheck"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_24"
                android:background="@drawable/bg_draft_check_unselected"
                app:tint="#FFFFFF"
                android:padding="2dp"
                android:visibility="gone" />
        </FrameLayout>

    </RelativeLayout>

</FrameLayout>
